+	/*
+	* Checks whether both the first and the last byte of a range are readable. That covers the whole range as long as it is
+	* smaller than a page. Without the check on the last byte, a pointer into the last bytes of the image passes and the
+	* following string comparison reads beyond the end of the image.
+	*/
+	bool IsRangeReadable(const uintptr_t Address, const size_t NumBytes)
+	{
+		auto IsReadable = [](const uintptr_t Addr) -> bool
+		{
+			return PlatformWindows::IsAddressInProcessRange(Addr) && (IsInAnySection(Addr, IMAGE_SCN_MEM_READ) || !PlatformWindows::IsBadReadPtr(Addr));
+		};
+
+		return NumBytes > 0 && IsReadable(Address) && IsReadable(Address + NumBytes - 1);
+	}
 }
